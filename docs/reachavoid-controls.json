[
  {
    "id": "stall",
    "title": "A winning successor can still stall",
    "input": {
      "arena": {
        "states": [
          {
            "name": "choose",
            "owner": "controller",
            "safe": true,
            "moves": [
              {
                "action": "wait",
                "to": "choose"
              },
              {
                "action": "finish",
                "to": "done"
              }
            ]
          },
          {
            "name": "done",
            "owner": "environment",
            "safe": true,
            "moves": [
              {
                "action": "after",
                "to": "bad"
              }
            ]
          },
          {
            "name": "bad",
            "owner": "controller",
            "safe": false,
            "moves": [
              {
                "action": "stay",
                "to": "bad"
              }
            ]
          }
        ]
      },
      "goals": [
        "done"
      ]
    },
    "why": "Both wait and finish target winning states. Repeating wait never reaches the goal; finish has worst-case bound of 1. Goal success stops before the after move."
  },
  {
    "id": "owner_flip",
    "title": "The environment can wait forever",
    "input": {
      "arena": {
        "states": [
          {
            "name": "choose",
            "owner": "environment",
            "safe": true,
            "moves": [
              {
                "action": "wait",
                "to": "choose"
              },
              {
                "action": "finish",
                "to": "done"
              }
            ]
          },
          {
            "name": "done",
            "owner": "environment",
            "safe": true,
            "moves": [
              {
                "action": "after",
                "to": "bad"
              }
            ]
          },
          {
            "name": "bad",
            "owner": "controller",
            "safe": false,
            "moves": [
              {
                "action": "stay",
                "to": "bad"
              }
            ]
          }
        ]
      },
      "goals": [
        "done"
      ]
    },
    "why": "Changing only the owner of choose removes its reach-avoid guarantee. It remains safe-until-goal. No fairness assumption forces finish."
  },
